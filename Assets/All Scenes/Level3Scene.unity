  m_Script: {fileID: 11500000, guid: b71cb9b45ea085d4c9b4e74e66463d8b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  storyPanel: {fileID: 916133526}
  storyText: {fileID: 916133525}
  storyLines:
  - "Torin\u2019in Ruhu: Kim cesaret eder benim karanl\u0131\u011F\u0131ma inmeye?!"
  - "Luna: Torin Usta\u2026 Ruhunuz ba\u011Flanm\u0131\u015F. Sizi kurtarmaya geldim."
  - "Torin: Malvaren\u2026 nank\xF6r! Onu \xE7ocukken ben b\xFCy\xFCtt\xFCm. \u015Eimdi
    g\xFCc\xFCm\xFCz\xFC \xE7ald\u0131!"
  - "Luna: Onu durduraca\u011F\u0131m. Ama g\xFCc\xFCn\xFCze ihtiyac\u0131m var."
  - "Torin: Sende cesaret var\u2026 g\xF6lgemize yenilmeyen tek ki\u015Fi sensin.\n(Luna
    ruhu serbest b\u0131rak\u0131r.)"
  - "Torin: A\u011F\u0131r sald\u0131r\u0131 tekni\u011Fim senin. G\xFC\xE7 +1. Unutma\u2026
    Malvaren\u2019e giden yol yeralt\u0131ndan de\u011Fil, kendi kalbinden ge\xE7er."
  lineDisplayTime: 2
