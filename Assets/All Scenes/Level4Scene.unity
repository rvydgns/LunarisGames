  m_EditorClassIdentifier: 
  storyPanel: {fileID: 283900992}
  storyText: {fileID: 1092456305}
  storyLines:
  - "Celene: Luna\u2026 beni kurtard\u0131ysan, hep,mizi kurtard\u0131n demektir.
    Ona gitmeden \xF6nce son duraktas\u0131n."
  - "Celene: Malvaren bizi kurtarmaya \xE7al\u0131\u015Ft\u0131.\nAma zaman\u0131
    kontrol eden, sonunda ona esir olur."
  - "Luna: Onu durduraca\u011F\u0131m."
  - "Celene: Zaman sana kar\u015F\u0131l\u0131k verdi."
  - "Zaman Kayd\u0131rma yetene\u011Fi a\xE7\u0131ld\u0131"
  - "Celene: Malvaren Kader Kulesi\u2019nde ve kasabay\u0131 esir etmi\u015F halde
    onu orada bulacaks\u0131n.\nOrada zaman durur\u2026 ve kader karar\u0131n\u0131
    bekler."
  lineDisplayTime: 3
